<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gk.relay.dao.RelayGroupDao">

    <resultMap type="com.gk.relay.entity.RelayGroupEntity" id="accessGroupMap">
        <result property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="groupCode" column="group_code"/>
        <result property="groupName" column="group_name"/>
        <result property="groupType" column="group_type"/>
        <result property="status" column="status"/>
        <result property="maxNodes" column="max_nodes"/>
        <result property="maxClients" column="max_clients"/>
        <result property="remark" column="remark"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deleted" column="deleted"/>
        <result property="version" column="version"/>
    </resultMap>

    <select id="getByClientId" resultType="com.gk.relay.entity.RelayGroupEntity">
        SELECT g.*
        FROM relay_group g
            LEFT JOIN relay_group_client gc ON g.id = gc.client_id
        WHERE gc.client_id = #{clientId}
        GROUP BY g.id
    </select>

</mapper>