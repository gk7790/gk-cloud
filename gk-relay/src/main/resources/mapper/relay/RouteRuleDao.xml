<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gk.relay.dao.RouteRuleDao">

    <resultMap type="com.gk.relay.entity.RouteRuleEntity" id="routeRuleMap">
        <result property="id" column="id"/>
        <result property="policyId" column="policy_id"/>
        <result property="ruleName" column="rule_name"/>
        <result property="description" column="description"/>
        <result property="ruleKind" column="rule_kind"/>
        <result property="matchType" column="match_type"/>
        <result property="matchJson" column="match_json"/>
        <result property="actionType" column="action_type"/>
        <result property="outboundTag" column="outbound_tag"/>
        <result property="logicalMode" column="logical_mode"/>
        <result property="childRules" column="child_rules"/>
        <result property="invert" column="invert"/>
        <result property="rawJson" column="raw_json"/>
        <result property="extraJson" column="extra_json"/>
        <result property="enabled" column="enabled"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="deleted" column="deleted"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="listActiveByPolicyId" resultType="com.gk.relay.entity.RouteRuleEntity">
        SELECT * FROM relay_route_rule rr WHERE rr.enabled = 1 AND rr.policy_id = #{policyId}
    </select>

</mapper>