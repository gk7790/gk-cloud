<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gk.relay.dao.RelayClientDao">

    <resultMap type="com.gk.relay.entity.RelayClientEntity" id="relayClientMap">
        <result property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="clientCode" column="client_code"/>
        <result property="clientName" column="client_name"/>
        <result property="username" column="username"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="password" column="password"/>
        <result property="clientType" column="client_type"/>
        <result property="status" column="status"/>
        <result property="expireAt" column="expire_at"/>
        <result property="totalLimitBytes" column="total_limit_bytes"/>
        <result property="usedTotalBytes" column="used_total_bytes"/>
        <result property="maxConnections" column="max_connections"/>
        <result property="lastLoginAt" column="last_login_at"/>
        <result property="lastLoginIp" column="last_login_ip"/>
        <result property="remark" column="remark"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deleted" column="deleted"/>
        <result property="version" column="version"/>
    </resultMap>

    <select id="findByUsername" resultType="com.gk.relay.entity.RelayClientEntity">
        SELECT * FROM `relay_client` c WHERE c.username = #{username} or c.email = #{username} or c.phone = #{username} limit 1
    </select>

</mapper>